# Copy to .env and fill in before: docker compose up -d --build

# TeslaMate PostgreSQL (query service is read-only)
# From inside Docker, host Postgres is usually:
#   DB_HOST=host.docker.internal
# On the same compose network as TeslaMate's database service:
#   DB_HOST=database
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=teslamate
DB_USER=teslamate
DB_PASS=secret

# Query service (compose-internal Grafana → no API key needed)
AUTH_ENABLED=false
API_KEYS=dev-api-key
QUERY_PORT=8080

# Grafana UI
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
